# ==============================================================
# Placement Management System — Backend Environment Configuration
# ==============================================================

# Server Port (Render sets this automatically to 10000; defaults to 5000 locally)
PORT=5000

# Runtime Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# MongoDB Connection String (Required)
# Local: mongodb://127.0.0.1:27017/placement_management_db
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/placement_management_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_management_db?retryWrites=true&w=majority

# JWT Authentication Secret (Use a secure, random 32+ character string in production)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS & Email Links
# Set to your Netlify deployment URL (can be comma-separated list of origins)
CLIENT_URL=https://placementmanagementportal.netlify.app

# ==============================================================
# Optional: SMTP Email Service Configuration (For Student Credentials Delivery)
# If not configured, credential emails will run in simulation mode without crashing.
# ==============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-placement-cell@gmail.com
# SMTP_PASS=your-google-app-password
# FROM_EMAIL=placement-cell@university.edu
