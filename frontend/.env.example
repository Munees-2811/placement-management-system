# Backend API Base URL
# Local development: http://localhost:5000/api
# Production (Render): https://<your-render-service-name>.onrender.com/api
# Note: For Render, use your HTTPS service URL (optionally ending in /api).
# This setting is embedded into the frontend bundle at build time; redeploy Netlify after changing it.
VITE_API_BASE_URL=http://localhost:5000/api
