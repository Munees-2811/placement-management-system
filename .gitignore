# Root gitignore for Student Placement Management System

# Dependencies
node_modules/
*/node_modules/

# Environment files & secrets (DO NOT COMMIT)
.env
.env.*
*.env
!.env.example
!*/.env.example

# Build outputs
dist/
dist-ssr/
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & local data
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
